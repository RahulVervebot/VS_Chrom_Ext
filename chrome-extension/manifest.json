{
  "manifest_version": 3,
  "name": "AI Project Bridge",
  "short_name": "AI Project",
  "version": "0.1.0",
  "description": "Companion to the AI Project Intelligence VS Code extension: sends project context to ChatGPT, Claude or Gemini, validates the answers and returns structured knowledge to VS Code.",
  "minimum_chrome_version": "116",
  "icons": { "16": "public/icons/icon16.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png" },
  "action": { "default_title": "AI Project Bridge" },
  "side_panel": { "default_path": "public/panel.html" },
  "background": { "service_worker": "dist/background.js" },
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "scripting", "alarms", "downloads"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    { "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["dist/content-chatgpt.js"], "run_at": "document_idle" },
    { "matches": ["https://claude.ai/*"], "js": ["dist/content-claude.js"], "run_at": "document_idle" },
    { "matches": ["https://gemini.google.com/*"], "js": ["dist/content-gemini.js"], "run_at": "document_idle" }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
